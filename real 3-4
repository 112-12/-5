function getCourseStudents(courseText){

  const teacherName = getUserInfo().name;

  const sh = SpreadsheetApp
    .getActiveSpreadsheet()
    .getSheetByName("課程資料");

  const data = sh.getDataRange().getValues();

  const result=[];

  for(let i=1;i<data.length;i++){

    const course =
      data[i][5] + "（" + data[i][6] + "）";

    if(
      data[i][8] == teacherName &&
      course == courseText
    ){

      result.push({
        no:data[i][0],
        className:data[i][1],
        seat:data[i][2],
        studentId:data[i][3],
        name:data[i][4]
      });

    }
  }

  return result;
}
