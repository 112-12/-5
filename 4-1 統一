function getCurrentPeriod() {

  const now = new Date();

  const hhmm =
    Utilities.formatDate(
      now,
      Session.getScriptTimeZone(),
      "HH:mm"
    );

  const periods = [
    ["08:10","09:00",1],
    ["09:10","10:00",2],
    ["10:10","11:00",3],
    ["11:10","12:00",4],
    ["13:10","14:00",5],
    ["14:10","15:00",6],
    ["15:10","16:00",7],
    ["16:10","17:00",8],
    ["17:10","18:00",9]
  ];

  for(let p of periods){

    if(hhmm >= p[0] && hhmm <= p[1]){
      return p[2];
    }

  }

  return 0;
}
