function sendStudent(index){

  if(index >= selectedRows.length){

    alert("發送完成");

    document
      .querySelectorAll(
        ".studentCheck"
      )
      .forEach(c=>c.checked=false);

    updateCount();

    return;
  }

  document.getElementById(
    "progress"
  ).innerHTML =
    `正在發送 (${index+1}/${selectedRows.length})`;

  google.script.run
    .withSuccessHandler(()=>{

      sendStudent(index+1);

    })
    .sendOneMail(
      selectedRows[index],
      testMode
    );

}
